# Names only. Never commit real values.
# Bun loads .env automatically; copy this file to .env and fill it in.

NODE_ENV=development
PORT=3001

# PostgreSQL. TEST_DATABASE_URL must point at a different database — tests are destructive.
#
# On a hosted DATABASE_URL (Neon, Railway, Supabase), add `sslmode=verify-full` rather than
# `sslmode=require`: pg 8.23 already treats them identically but warns on every single boot,
# and pg 9 will change what `require` means. Explicit is quieter and survives the upgrade.
#
# Keep TEST_DATABASE_URL LOCAL. The suite truncates every table between each of ~300 cases;
# over a network, on a free tier that auto-suspends, that is slow and burns compute for
# nothing. One command: createdb resort_test
DATABASE_URL=
TEST_DATABASE_URL=postgres://localhost:5432/resort_test

# Origins, no trailing slash. APP_ORIGIN drives the CORS allowlist and cookie scope.
APP_ORIGIN=http://localhost:5173
API_PUBLIC_ORIGIN=http://localhost:3001

# Signs short-lived access tokens. At least 32 characters.
# Refresh credentials are opaque random values stored as hashes, so they need no secret.
JWT_SECRET=

# Google sign-in. Both together, or neither.
# There is no GOOGLE_REDIRECT_URI: it is derived as
#   <API_PUBLIC_ORIGIN>/api/user/auth/google/callback
# because we own that route, and a hand-maintained copy can only drift away from it. Paste
# that URL into the Google Cloud console as an Authorised redirect URI — Google requires an
# exact pre-registered match and rejects anything else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI. Absent key disables the pipeline loudly rather than faking it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Exposes mock OTP codes and payment controls for seeded reviewer identities only.
DEMO_MODE=false
